# Copy to .env and fill in values: cp .env.example .env
#
# In development, Rails loads .env automatically (via the dotenv gem) if the file exists.
# Variables already set in your shell take precedence. .env is gitignored; never commit it.
# Production does not read this file: Kamal passes variables in from config/deploy.yml
# and .kamal/secrets. Every variable below is optional in development.

# --- App ---------------------------------------------------------------------

# Sender address for link emails.
# MAIL_FROM="Linkletter <no-reply@example.com>"

# --- Database ----------------------------------------------------------------

# Leave unset to connect over the local socket (e.g. Postgres.app).
# DB_HOST=localhost

# --- Server ------------------------------------------------------------------

# PORT=3000
# RAILS_MAX_THREADS=3

# --- Production only (set these in config/deploy.yml / .kamal/secrets) -------
# Listed here so every variable the app reads is documented in one place.
#
# APP_HOST=links.example.com             # domain used in emailed personal links
# SECRET_KEY_BASE=                       # generate with: bin/rails secret
# SMTP_ADDRESS=smtp.example.com          # enables SMTP delivery when set
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain              # plain, login or cram_md5
# LINKLETTER_DATABASE_PASSWORD=
# SOLID_QUEUE_IN_PUMA=true
# JOB_CONCURRENCY=1
# WEB_CONCURRENCY=1
# RAILS_LOG_LEVEL=info
