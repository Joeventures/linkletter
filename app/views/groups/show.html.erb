<% content_for :title, @group.name %>
<nav class="small mb-2"><%= link_to "← Groups", groups_path %></nav>
<div class="d-flex justify-content-between align-items-start mb-4 gap-2 flex-wrap">
  <div>
    <h1 class="h3 mb-1"><%= @group.name %></h1>
    <% if @group.description.present? %><p class="text-body-secondary mb-0"><%= @group.description %></p><% end %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Add link", new_group_link_path(@group), class: "btn btn-primary" %>
    <%= link_to "Edit", edit_group_path(@group), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", @group, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete this group, its members, links, and all click history?" } } %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Links</div>
      <% if @links.any? %>
        <div class="list-group list-group-flush">
          <% @links.each do |link| %>
            <%= link_to group_link_path(@group, link), class: "list-group-item list-group-item-action" do %>
              <div class="d-flex justify-content-between">
                <span class="fw-semibold text-truncate me-2"><%= link.display_title %></span>
                <span class="small text-body-secondary text-nowrap">
                  <%= link.personal_links.count { |pl| pl.clicks_count > 0 } %>/<%= link.personal_links.size %> clicked
                </span>
              </div>
              <div class="small text-body-secondary text-truncate"><%= link.url %></div>
              <div class="small text-body-secondary">
                <%= link.sent_at ? "Sent #{time_ago_in_words(link.sent_at)} ago" : "Not sent" %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="card-body text-body-secondary">No links yet. Add one to email each member their personal link.</div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Members (<%= @group.members.size %>)</div>
      <ul class="list-group list-group-flush">
        <% @group.members.each do |member| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div class="text-truncate">
              <div><%= member.name %></div>
              <div class="small text-body-secondary"><%= member.email_address %></div>
            </div>
            <div class="d-flex gap-1">
              <%= link_to "Edit", edit_group_member_path(@group, member), class: "btn btn-sm btn-link" %>
              <%= button_to "Remove", group_member_path(@group, member), method: :delete, class: "btn btn-sm btn-link text-danger",
                    form: { data: { turbo_confirm: "Remove #{member.name}? Their personal links will stop working and their click history will be deleted." } } %>
            </div>
          </li>
        <% end %>
      </ul>
      <div class="card-body border-top">
        <%= form_with model: [ @group, @member ], class: "row g-2" do |form| %>
          <div class="col-sm-5"><%= form.text_field :name, placeholder: "Name", required: true, class: "form-control form-control-sm" %></div>
          <div class="col-sm-5"><%= form.email_field :email_address, placeholder: "Email", required: true, class: "form-control form-control-sm" %></div>
          <div class="col-sm-2"><%= form.submit "Add", class: "btn btn-sm btn-outline-primary w-100" %></div>
        <% end %>
        <details class="mt-3">
          <summary class="small">Add many at once</summary>
          <%= form_with url: import_group_members_path(@group), class: "mt-2" do |form| %>
            <%= form.text_area :members_text, rows: 5, class: "form-control form-control-sm font-monospace",
                  placeholder: "Jane Doe, jane@example.com\nJohn Smith <john@example.com>" %>
            <div class="form-text">One per line: <code>Name, email</code> or <code>Name &lt;email&gt;</code>.</div>
            <%= form.submit "Import", class: "btn btn-sm btn-outline-primary mt-2" %>
          <% end %>
        </details>
      </div>
    </div>
  </div>
</div>
