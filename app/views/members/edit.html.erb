<% content_for :title, "Edit #{@member.name}" %>
<nav class="small mb-2"><%= link_to "← #{@group.name}", @group %></nav>
<h1 class="h3 mb-3">Edit member</h1>
<div class="card shadow-sm"><div class="card-body">
  <%= form_with model: [ @group, @member ] do |form| %>
    <%= render "shared/errors", record: @member %>
    <div class="mb-3"><%= form.label :name, class: "form-label" %><%= form.text_field :name, required: true, class: "form-control" %></div>
    <div class="mb-3"><%= form.label :email_address, class: "form-label" %><%= form.email_field :email_address, required: true, class: "form-control" %></div>
    <%= form.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", @group, class: "btn btn-link" %>
  <% end %>
</div></div>
